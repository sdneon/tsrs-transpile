+    #[unsafe(no_mangle)]
+    pub extern "C" fn tsrs_transpile() -> i32 {
+        let default_hook = std::panic::take_hook();
+        std::panic::set_hook(Box::new(move |info| {
+            default_hook(info);
+            std::process::exit(5);
+        }));
+        tsrs_compiler::worker_pool();
+        let request = INPUT.with_borrow_mut(std::mem::take);
